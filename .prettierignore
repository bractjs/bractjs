# Keep in sync with the ignore list in eslint.config.mjs.
node_modules
build
dist
**/_generated
**/route-types.gen.ts

# Emitted by `bun run typegen` (tsc --emitDeclarationOnly), and CI fails on any
# diff against a fresh regeneration. Formatting these would be a standoff:
# `prettier --write` reformats them, then the next typegen writes tsc's own
# formatting back and the drift guard fails. tsc owns this directory.
packages/core/types
pnpm-lock.yaml
**/.tmp-*
examples/*/src/client
examples/cms/app/styles.css

# Generated Tailwind output (built by `bun run css`, gitignored) — must not be
# formatted or the next css build re-minifies it and fails the format check.
examples/*/public/styles.css
