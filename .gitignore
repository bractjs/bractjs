# Dependencies
node_modules/
jspm_packages/

# Lockfiles from other package managers (pnpm-lock.yaml is the source of truth)
package-lock.json
yarn.lock
bun.lock
bun.lockb
examples/*/bun.lock
examples/*/bun.lockb

# Build outputs (anchored to repo root so they don't match source dirs like
# src/build/ — an unanchored `build/` ignores that dir at ANY depth).
/build/
/dist/
/out/
/lib/
examples/*/build/
*.tsbuildinfo

# Packaging artifacts
*.tgz
*.tar.gz

# Environment & secrets
.env
.env.*
*.local
!.env.example

# Generated files
app/route-types.gen.ts
# Module-registry codegen output (regenerated by `bractjs codegen:registry`)
app/_generated/

# Test temp fixtures (leak when tests fail mid-run)
src/__tests__/.tmp-*
tmp/
.tmp/

# Example app local state (the apps themselves are tracked)
examples/*/node_modules/
examples/*/app/_generated/
# Dev-rebuilder client bundles (content-hashed, regenerated on every dev run)
examples/*/src/client/
examples/*/app/route-types.gen.ts
examples/*/.bract-image-cache/
examples/*/bin/
examples/*/*.db
examples/*/*.db-*
examples/*/*.sqlite

# Cache
.bract-image-cache/
.cache/
.bun/
.parcel-cache/
.eslintcache
.stylelintcache

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Internal docs not meant for the repo
bract-*.md
# Maintainer-local, deliberately never committed. These were previously kept out
# only by a global ~/.config/git/ignore rule, which is invisible to anyone else
# and to tooling — listing them here makes the exclusion explicit and survives a
# fresh clone or a change to that global config.
PUBLISH_GUIDE.md
CLAUDE.md
SECURITY.md
.github/PULL_REQUEST_TEMPLATE.md

# Test coverage
coverage/
*.lcov
.nyc_output/

# Private tooling
.claude/

# Playwright MCP scratch output
.playwright-mcp/
