{
  "name": "bractjs-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "BractJS monorepo — pnpm workspace for the @bractjs/bractjs framework and example apps.",
  "license": "MIT",
  "scripts": {
    "dev": "bun run packages/core/src/dev/server.ts",
    "build": "pnpm --filter @bractjs/bractjs build",
    "test": "pnpm --filter @bractjs/bractjs test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  },
  "version": "0.0.2"
}
