# examples/cms — copy to `.env` (Bun auto-loads it). Everything here is OPTIONAL:
# with none of it set, the app runs on :3200, prints the 2FA code to the console,
# and hides the OAuth buttons.  cp .env.example .env

# ── Core ─────────────────────────────────────────────────────────────────────
# NODE_ENV=production           # set by the build/start scripts; leave unset in dev
PORT=3200
# Absolute public origin. Must match the OAuth redirect URIs registered below.
APP_URL=http://localhost:3200
APP_NAME=Bract Gazette CMS

# Set to 1 ONLY when the app sits behind a reverse proxy you control that sets
# X-Forwarded-For / X-Real-IP. When unset, those headers are ignored for rate
# limiting (they're client-spoofable), so IP-based limits won't be fooled.
# TRUST_PROXY=1

# HMAC secret for the signed session/MFA/OAuth-state cookies. MUST be >= 16 chars.
# REQUIRED in production — the app refuses to boot with NODE_ENV=production unless
# this is set to a strong, non-default value. Generate one, e.g.
#   openssl rand -base64 32
# Leave it unset in local dev to use the built-in insecure dev fallback.
# SESSION_SECRET=

# ── Data & uploads ───────────────────────────────────────────────────────────
# SQLite file + upload dir resolve against the process CWD (matters under
# `bun build --compile`). Defaults shown.
CMS_DB=./cms.db
UPLOAD_DIR=./public/uploads

# ── Seeded admin / second factor ─────────────────────────────────────────────
# Where the seeded `admin` account's 6-digit 2FA code is emailed. Only used the
# first time the DB is seeded.
ADMIN_EMAIL=admin@example.com

# ── SMTP (second-factor email delivery) ──────────────────────────────────────
# Omit entirely to use the dev fallback (the code is logged to the server
# console). All four of HOST/PORT/USER/PASS are needed to enable real sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                 # 465 = implicit TLS, anything else = STARTTLS
# SMTP_USER=apikey
# SMTP_PASS=super-secret
# SMTP_FROM=Bract Gazette CMS <no-reply@example.com>

# ── OAuth: Sign in with Google ───────────────────────────────────────────────
# Redirect URI to register: ${APP_URL}/api/auth/google/callback
# The button only appears when BOTH are set. (Google Cloud Console → Credentials)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx

# ── OAuth: Sign in with Microsoft ────────────────────────────────────────────
# Redirect URI to register: ${APP_URL}/api/auth/microsoft/callback
# MS_TENANT defaults to "organizations" (work/school accounts only). Prefer a
# specific tenant id for the tightest scope. Avoid "common", which also accepts
# personal Microsoft accounts (untrusted email). (Azure → App registrations)
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_CLIENT_SECRET=xxxxxxxx
# MS_TENANT=organizations
