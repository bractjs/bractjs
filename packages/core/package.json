{
  "name": "@bractjs/bractjs",
  "version": "0.3.2",
  "description": "Production-grade SSR framework for Bun + React 19. File-based routing, streaming SSR, server actions, typed routes.",
  "license": "MIT",
  "homepage": "https://github.com/bractjs/bractjs#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bractjs/bractjs.git"
  },
  "bugs": {
    "url": "https://github.com/bractjs/bractjs/issues"
  },
  "keywords": [
    "bun",
    "react",
    "react19",
    "ssr",
    "framework",
    "routing",
    "server-actions",
    "streaming",
    "typescript",
    "full-stack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/__tests__",
    "bin",
    "types",
    "templates",
    "LICENSE"
  ],
  "bin": {
    "bractjs": "./bin/cli.ts"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./types/build-entry.d.ts",
      "default": "./src/build-entry.ts"
    },
    "./codegen": {
      "types": "./types/codegen-entry.d.ts",
      "default": "./src/codegen-entry.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/dev/server.ts",
    "build": "bun run src/build/bundler.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p tsconfig.types.json",
    "typegen": "bunx tsc -p tsconfig.declarations.json",
    "prepublishOnly": "bun run typegen && bun run scripts/verify-pack.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
